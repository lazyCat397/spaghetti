// a few helpers for dealing with user input
// because apparently readLine isn't quite enough for everything

struct Fork {
    _v: int

    // the simplest one. ask, receive, done.
    function askString(prompt: string) -> string {
        return readLine(prompt)
    }

    // sometimes having a fallback is all you need
    function askStringOr(prompt: string, fallback: string) -> string {
        try {
            return readLine(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // numbers are a little trickier, so let's keep asking until we get one
    function askInt(prompt: string) -> int {
        while (true) {
            let raw = readLine(prompt)
            try {
                return @into.int(raw)
            } catch (e: string) {
                printError("Oops! \"" + raw + "\" is not a whole number. Try again.")
            }
        }
        return 0
    }

    // same thing, but with a fallback
    // hopefully the user gets it right before we need one :)
    function askIntOr(prompt: string, fallback: int) -> int {
        try {
            return me.askInt(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // floats get a little extra attention
    // special values are cool, but not always what we want here
    function askFloat(prompt: string) -> float {
        while (true) {
            let raw = readLine(prompt)
            let low = @str.toLower(@str.trim(raw))
            if (@str.contains(low, "n") || @str.contains(low, "i")) {
                printError("Oops! \"" + raw + "\" is not a valid number. Try again.")
            } else {
                try {
                    return @into.float(raw)
                } catch (e: string) {
                    printError("Oops! \"" + raw + "\" is not a number. Try again.")
                }
            }
        }
        return 0.0
    }

    function askFloatOr(prompt: string, fallback: float) -> float {
        try {
            return me.askFloat(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // yes/no questions, now with a few extra ways to say yes
    // because not everyone speaks the same terminal language :/
    function askYesNo(prompt: string) -> bool {
        while (true) {
            let low = @str.toLower(@str.trim(readLine(prompt + " [y/n]: ")))
            if (low == "y" || low == "yes" || low == "s" || low == "sim") { return true }
            elif (low == "n" || low == "no" || low == "não" || low == "nao") { return false }
            printError("Oops! Answer with y or n.")
        }
        return false
    }

    function askYesNoOr(prompt: string, fallback: bool) -> bool {
        try {
            return me.askYesNo(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // file stuff!
    // reading lines without having to split the whole file yourself
    function readLines(path: string) -> array<string> {
        return @file.lines(path)
    }

    // write a list of lines back to a file
    // we'll take care of the newlines, don't worry
    function writeLines(path: string, lines: array<string>) -> void {
        let text = ""
        for line in lines {
            text += line + "\n"
        }
        @file.write(path, text)
    }

    // add a line at the end. that's it, that's the feature.
    function appendLine(path: string, line: string) -> void {
        @file.append(path, line + "\n")
    }

    // if the file doesn't exist, just use the fallback
    // no need to make a whole thing out of it
    function readOr(path: string, fallback: string) -> string {
        if (@file.exists(path)) {
            return @file.read(path)
        }
        return fallback
    }

    // and a couple of formatting helpers for nicer console output
    // nothing too fancy, just the basics

    // pick a character, pick a width, get a line
    function rule(width: int, char: string) -> string {
        return @str.repeat(char, width)
    }

    // center some text, more or less
    // if it doesn't fit, we'll let it be
    function center(text: string, width: int) -> string {
        let space = width - @str.len(text)
        if (space <= 0) { return text }
        let left = space / 2
        let right = space - left
        return @str.repeat(" ", left) + text + @str.repeat(" ", right)
    }

    // a tiny box for your text
    // suddenly your terminal output looks like you put in some effort
    function box(text: string) -> string {
        let width = @str.len(text)
        let edge = "+" + @str.repeat("-", width + 2) + "+"
        return edge + "\n| " + text + " |\n" + edge
    }

}

export const fork: Fork = Fork { _v: 0 }
