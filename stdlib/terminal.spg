// `attach #terminal`: questions and a bit of console output [v0.1]
// because apparently readLine isn't quite enough for everything
// *=------------->
// `#terminal` v0.2, from a struct and a constant to a native namespace!
public namespace terminal {
    // the simplest one. ask, receive, done
    public fn askString(prompt: string) -> string {
        return readLine(prompt)
    }

    // same thing, but with a fallback
    public fn askStringOr(prompt: string, fallback: string) -> string {
        try {
            return readLine(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // numbers are a little trickier, we  will ask again until the result is valid
    public fn askInt(prompt: string) -> int {
        while (true) {
            let raw = readLine(prompt)
            try {
                return @into.int(raw)
            } catch (e: string) {
                printError("Oops! ${raw} is not a whole number. Try again.")
            }
        }
        return 0
    }

    // fallback version
    public fn askIntOr(prompt: string, fallback: int) -> int {
        try {
            return askInt(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // floats get a little extra attention..
    public fn askFloat(prompt: string) -> float {
        while (true) {
            let raw = readLine(prompt)
            let low = @str.toLower(@str.trim(raw))
            if (@str.contains(low, "n") || @str.contains(low, "i")) {
                printError("Oops! ${raw} is not a valid number. Try again.")
            } else {
                try {
                    return @into.float(raw)
                } catch (e: string) {
                    printError("Oops! ${raw} is not a number. Try again.")
                }
            }
        }
        return 0.0
    }

    public fn askFloatOr(prompt: string, fallback: float) -> float {
        try {
            return askFloat(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // yes/no questions, now with a few extra ways to say yes, idk why
    public fn askYesNo(prompt: string) -> bool {
        while (true) {
            let low = @str.toLower(@str.trim(readLine(prompt + " [y/n]: ")))
            if (low == "y" || low == "yes" ) { return true }
            elif (low == "n" || low == "no" ) { return false }
            printError("Oops! Answer with y or n.")
        }
        return false
    }

    public fn askYesNoOr(prompt: string, fallback: bool) -> bool {
        try {
            return askYesNo(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // and a couple of formatting helpers for nicer console output
    // nothing too fancy, just the basics

    // pick a character, pick a width, get a line
    public fn rule(width: int, char: string) -> string {
        return @str.repeat(char, width)
    }

    // center some text, more or less
    // also, some terminals might not use monospaced
    // fonts, and this mostly depends on every
    // character having around the same size
    public fn center(text: string, width: int) -> string {
        let space = width - @str.len(text)
        if (space <= 0) { return text }
        let left = space / 2
        let right = space - left
        return @str.repeat(" ", left) + text + @str.repeat(" ", right)
    }

    // a tiny box for your text
    public fn box(text: string) -> string {
        let width = @str.len(text)
        let edge = "+" + @str.repeat("-", width + 2) + "+"
        return edge + "\n| " + text + " |\n" + edge
    }

}
