// `attach #terminal`: questions and a bit of console output
// because apparently readLine isn't quite enough for everything
// (file helpers live in @file now: @file.readLines, @file.writeLines, ...)

struct Terminal {
    _v: int

    // the simplest one. ask, receive, done.
    fn askString(prompt: string) -> string {
        return readLine(prompt)
    }

    // sometimes having a fallback is all you need
    fn askStringOr(prompt: string, fallback: string) -> string {
        try {
            return readLine(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // numbers are a little trickier, so let's keep asking until we get one
    fn askInt(prompt: string) -> int {
        while (true) {
            let raw = readLine(prompt)
            try {
                return @into.int(raw)
            } catch (e: string) {
                printError("Oops! ${raw} is not a whole number. Try again.")
            }
        }
        return 0
    }

    // same thing, but with a fallback
    // hopefully the user gets it right before we need one :)
    fn askIntOr(prompt: string, fallback: int) -> int {
        try {
            return me.askInt(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // floats get a little extra attention
    // special values are cool, but not always what we want here
    fn askFloat(prompt: string) -> float {
        while (true) {
            let raw = readLine(prompt)
            let low = @str.toLower(@str.trim(raw))
            if (@str.contains(low, "n") || @str.contains(low, "i")) {
                printError("Oops! ${raw} is not a valid number. Try again.")
            } else {
                try {
                    return @into.float(raw)
                } catch (e: string) {
                    printError("Oops! ${raw} is not a number. Try again.")
                }
            }
        }
        return 0.0
    }

    fn askFloatOr(prompt: string, fallback: float) -> float {
        try {
            return me.askFloat(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // yes/no questions, now with a few extra ways to say yes, idk why
    fn askYesNo(prompt: string) -> bool {
        while (true) {
            let low = @str.toLower(@str.trim(readLine(prompt + " [y/n]: ")))
            if (low == "y" || low == "yes" ) { return true }
            elif (low == "n" || low == "no" ) { return false }
            printError("Oops! Answer with y or n.")
        }
        return false
    }

    fn askYesNoOr(prompt: string, fallback: bool) -> bool {
        try {
            return me.askYesNo(prompt)
        } catch (e: string) {
            return fallback
        }
    }

    // and a couple of formatting helpers for nicer console output
    // nothing too fancy, just the basics

    // pick a character, pick a width, get a line
    fn rule(width: int, char: string) -> string {
        return @str.repeat(char, width)
    }

    // center some text, more or less
    // if it doesn't fit, we'll let it be
    fn center(text: string, width: int) -> string {
        let space = width - @str.len(text)
        if (space <= 0) { return text }
        let left = space / 2
        let right = space - left
        return @str.repeat(" ", left) + text + @str.repeat(" ", right)
    }

    // a tiny box for your text
    // suddenly your terminal output looks like you put in some effort
    fn box(text: string) -> string {
        let width = @str.len(text)
        let edge = "+" + @str.repeat("-", width + 2) + "+"
        return edge + "\n| " + text + " |\n" + edge
    }

}

public const terminal: Terminal = Terminal { _v: 0 }
