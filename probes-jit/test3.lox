var i = 0;
var hits = 0;
var misses = 0;
while (i < 400) {
  var v = nil;
  if (i / 3 == 0) { v = true; }
  if (i / 5 == 1) { v = false; }
  if (i / 7 == 2) { v = i; }
  if (i / 11 == 3) { v = "s"; }
  if (v == nil) { misses = misses + 1; } else { hits = hits + 1; }
  if (v != nil and v != false) { hits = hits + 0; }
  i = i + 1;
}
print hits;
print misses;
print i == 400;
print nil == nil;
print "x" == "x";
