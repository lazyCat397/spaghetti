struct Item {
    n: int,
    label: string,
}

struct Bag {
    items: array<Item>,
    count: int,
}

fn sumN(b: Bag) -> int {
    let s = 0
    let i = 0
    while (i < @array.len(b.items)) {
        s = s + b.items[i].n
        i = i + 1
    }
    return s + b.count
}

fn pick(b: Bag, k: int) -> int {
    return b.items[k].n * 2
}

fn firstLabel(b: Bag) -> string {
    return b.items[0].label
}

fn forSum(b: Bag) -> int {
    let s = 0
    for (it in b.items) {
        s = s + it.n
    }
    return s
}

fn poke(b: Bag, v: int) {
    b.items[0] = Item { n: v, label: "p" }
}

let items: array<Item> = []
@array.push(items, Item { n: 1, label: "a" })
@array.push(items, Item { n: 2, label: "bb" })
@array.push(items, Item { n: 3, label: "ccc" })
let bag = Bag { items: items, count: 100 }

let total = 0
let i = 0
while (i < 1000000) {
    total = total + sumN(bag) + pick(bag, i % 3) + forSum(bag)
    i = i + 1
}
print(total)
print(firstLabel(bag))
poke(bag, 50)
print(sumN(bag))
print(bag.items[0].label)
