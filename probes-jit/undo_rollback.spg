struct Inner {
    n: int,
}

struct Box {
    v: int,
    inner: Inner,
}

fn churn(b: Box, rounds: int) -> int {
    let i = 0
    while (i < rounds) {
        b.v = b.v + 1
        b.inner.n = b.inner.n + 2
        b.inner = Inner { n: i }
        i = i + 1
    }
    return 1 / (b.v - rounds)
}

let b = Box { v: 0, inner: Inner { n: 7 } }
try {
    print(churn(b, 10000))
} catch (e) {
    print("caught")
}
print(b.v)
print(b.inner.n)
