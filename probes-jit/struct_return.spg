enum K { A, B, C }
struct P {
    k: K,
    flag: bool,
    num: float,
    text: string,
    n: int,
}
fn mk(n: int, s: string) -> P {
    return P { k: K.B, flag: n > 2, num: 1.5, text: s, n: n }
}
fn mkOrder(n: int, s: string) -> P {
    return P { text: s, n: n, num: 2.5, flag: true, k: K.C }
}
fn twice(n: int) -> int {
    let p = mk(n, "x")
    let q = mk(p.n + 1, "yy")
    return p.n + q.n
}
fn pass(p: P) -> P {
    return p
}
fn fieldsum(p: P) -> int {
    if (p.flag && p.k == K.B) {
        return p.n
    }
    return 0 - p.n
}
let total = 0
let i = 0
let last = mk(0, "init")
while (i < 200) {
    last = mk(i, "s")
    total = total + fieldsum(pass(last))
    total = total + twice(i)
    i = i + 1
}
print(total)
print(last.n)
print(last.text)
print(last.num)
print(last.flag)
print(last.k == K.B)
let o = mkOrder(7, "ord")
print(o.n)
print(o.text)
print(o.num)
print(o.flag)
print(o.k == K.C)
