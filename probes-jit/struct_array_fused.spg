struct Cell {
    k: int,
    x: float,
    on: bool,
    name: string,
}

struct Grid {
    cells: array<Cell>,
}

fn score(g: Grid, i: int) -> float {
    if (g.cells[i].on) {
        return g.cells[i].x * 2.0 + 1.0
    }
    return g.cells[i].x
}

fn count(g: Grid) -> int {
    let n = 0
    let i = 0
    while (i < @array.len(g.cells)) {
        if (g.cells[i].on) {
            n = n + g.cells[i].k
        }
        i = i + 1
    }
    return n
}

let cells: array<Cell> = []
@array.push(cells, Cell { k: 1, x: 0.5, on: true, name: "a" })
@array.push(cells, Cell { k: 2, x: 1.25, on: false, name: "b" })
@array.push(cells, Cell { k: 3, x: -2.75, on: true, name: "c" })
let grid = Grid { cells: cells }

let acc = 0.0
let total = 0
let r = 0
while (r < 300000) {
    acc = acc + score(grid, r % 3)
    total = total + count(grid)
    r = r + 1
}
print(acc)
print(total)
print(score(grid, 1))
print(grid.cells[2].name)
