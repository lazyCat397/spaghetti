struct P {
    n: int,
    x: float,
}

fn touch(p: P) -> int {
    return p.n + 1
}

fn run(rounds: int) -> int {
    let total = 0
    let i = 0
    while (i < rounds) {
        let p = P { n: i, x: 1.5 }
        total = total + touch(p)
        i = i + 1
    }
    return total
}

print(run(2000000))
