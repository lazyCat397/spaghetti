struct P {
    n: int,
    text: string,
}
fn mk(n: int, s: string) -> P {
    return P { n: n, text: s }
}
fn pass(p: P) -> P {
    return p
}
fn useTwo(p: P, d: int) -> int {
    return p.n + d
}
// struct locals alive when the division fails
fn localFail(n: int) -> int {
    let p = mk(n, "a" + "b")
    let q = mk(n + 1, "tmp")
    return p.n + q.n / (n - n)
}
// a struct sits on the operand stack (argument 1) while argument 2 fails
fn stackFail(n: int) -> int {
    return useTwo(mk(n, "arg"), n / (n - n))
}
// a struct came back from a native callee, then the caller fails
fn retFail(n: int) -> int {
    let p = pass(mk(n, "r" + "s"))
    return p.n / (n - n)
}
// the failure comes after a field store on a struct that came from outside
fn setFail(p: P, n: int) -> int {
    p.n = 999
    p.text = "changed"
    return n / (n - n)
}
let caught = 0
let i = 0
while (i < 5) {
    try { print(localFail(i + 1)) } catch (e) { caught = caught + 1 }
    try { print(stackFail(i + 1)) } catch (e) { caught = caught + 1 }
    try { print(retFail(i + 1)) } catch (e) { caught = caught + 1 }
    let keep = mk(7, "orig")
    try { print(setFail(keep, i + 1)) } catch (e) { caught = caught + 1 }
    // the VM must see the struct as it was before the failed native call
    print(keep.n)
    print(keep.text)
    i = i + 1
}
print(caught)
