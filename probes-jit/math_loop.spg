fn step(x: float, i: int) -> float {
    let r = @math.sqrt(x * x + 1.0)
    let f = @math.floor(r)
    let m = @math.min(r, 1000.0)
    let s = @math.sin(x) * 0.5
    return m + s + @math.abs(r - 3.0) + @math.clamp(x, -5.0, 5.0) * 0.001
}

fn count(i: int) -> int {
    return @math.max(@math.sign(i - 500), 0) + @math.clamp(i, 0, 1000) + @math.abs(i - 250)
}

let acc = 0.0
let n = 0
let i = 0
let x = 0.0
while (i < 400000) {
    acc = acc + step(x, i)
    n = n + count(i)
    x = x + 0.01
    i = i + 1
}
print(acc)
print(n)
