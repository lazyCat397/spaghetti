struct Box {
    v: int,
}

struct Holder {
    item: Box,
    count: int,
}

fn local(rounds: int) -> int {
    let b = Box { v: 0 }
    let i = 0
    while (i < rounds) {
        b.v = b.v + 1
        i = i + 1
    }
    return 1 / (b.v - rounds)
}

fn storeFresh(h: Holder, rounds: int) -> int {
    let i = 0
    while (i < rounds) {
        let nb = Box { v: i }
        nb.v = nb.v + 1
        h.item = nb
        h.count = h.count + 1
        i = i + 1
    }
    return 1 / (h.item.v - rounds)
}

let h = Holder { item: Box { v: 7 }, count: 0 }
try {
    print(local(20000))
} catch (e) {
    print("local caught")
}
try {
    print(storeFresh(h, 20000))
} catch (e) {
    print("store caught")
}
print(h.item.v)
print(h.count)
