export struct Vec2 { x: int, y: int }
export struct Caixa { canto: Vec2, lados: array<Vec2> }
export function novo(x: int, y: int) -> Vec2 { return Vec2 { x: x, y: y } }
export function sum(a: Vec2, b: Vec2) -> Vec2 { return Vec2 { x: a.x + b.x, y: a.y + b.y } }
export function pontos() -> array<Vec2> { return [novo(1, 2), novo(3, 4)] }
export let origem: Vec2 = Vec2 { x: 0, y: 0 }
