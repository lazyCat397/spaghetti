export struct Vec2 { x: int, y: int }
export struct Box { corner: Vec2, sides: array<Vec2> }
export function create(x: int, y: int) -> Vec2 { return Vec2 { x: x, y: y } }
export function sum(a: Vec2, b: Vec2) -> Vec2 { return Vec2 { x: a.x + b.x, y: a.y + b.y } }
export function points() -> array<Vec2> { return [create(1, 2), create(3, 4)] }
export let origin: Vec2 = Vec2 { x: 0, y: 0 }
