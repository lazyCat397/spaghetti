public struct Vec2 { x: int, y: int }
public struct Box { corner: Vec2, sides: array<Vec2> }
public fn create(x: int, y: int) -> Vec2 { return Vec2 { x: x, y: y } }
public fn sum(a: Vec2, b: Vec2) -> Vec2 { return Vec2 { x: a.x + b.x, y: a.y + b.y } }
public fn points() -> array<Vec2> { return [create(1, 2), create(3, 4)] }
public let origin: Vec2 = Vec2 { x: 0, y: 0 }
