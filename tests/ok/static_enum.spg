enum Color { Vermelho, Verde, Azul }
function Color.padrao() -> Color {
    return Color.Verde
}
function Color.de_numero(n: int) -> Color {
    if (n == 0) {
        return Color.Vermelho
    }
    return Color.Azul
}
let c = Color.padrao()
print(c == Color.Verde, Color.de_numero(0) == Color.Vermelho, Color.de_numero(9) == Color.Azul)
