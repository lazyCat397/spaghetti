const A: i8 = 100;
const C: i8 = -128;
const U: u8 = 200;
const V: u8 = 100;
const P: i8 = 2;
const SEVEN: i8 = 7;
const X: u64 = 9000000000;
const Y: u64 = 1000000000;
let s: i8 = A + A;
let d: i8 = C - A;
let m: i8 = A * A;
let q: i8 = C / A;
let r: i8 = C % A;
let pw: i8 = P ** SEVEN;
let us: u8 = U + V;
let ud: u8 = V - U;
let sum: u64 = X + Y;
let dif: u64 = X - Y;
print(s);
print(d);
print(m);
print(q);
print(r);
print(pw);
print(us);
print(ud);
print(sum);
print(dif);
