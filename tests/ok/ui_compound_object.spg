attach #ui
let win = ui.window("t", 20, 20)
let calls = [0]
fn mk(w: Window) -> Shape {
    calls[0] += 1
    return w.rect(1.0, 1.0, 2.0, 2.0, 5)
}
// the object is an expression with a side effect: it must run once, not once per read and write
let o = mk(win)
o.x += 1.0
print(calls[0])
let red = win.rect(2.0, 3.0, 4.0, 5.0, ui.hex("#ff3300"))
red.x += 1.5
print(red.x)
