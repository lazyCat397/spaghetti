// A jump landing in the MIDDLE of a fusable sequence must never be folded
// into a fused op (the pre-fix peephole did, and miscompiled all of these).
function lt(c: bool, a: int, b: int, d: int) -> bool {
    return (if (c) { a } else { b }) < d
}
function plus(c: bool, a: int, b: int) -> int {
    return (if (c) { a } else { b }) + b
}
function twice(x: int) -> int {
    return x * 2
}
function viaCall(c: bool, a: int, b: int) -> int {
    return twice(if (c) { a } else { b })
}
function andOr(x: int, y: int) -> int {
    if (x < y && y < 10 || x == 99) {
        return 1
    }
    return 0
}
print(lt(true, 1, 100, 5))
print(lt(false, 1, 100, 5))
print(plus(true, 10, 3))
print(plus(false, 10, 3))
print(viaCall(true, 4, 9))
print(viaCall(false, 4, 9))
print(andOr(1, 5))
print(andOr(1, 50))
print(andOr(99, 0))
