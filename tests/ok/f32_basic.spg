let x: f32 = 0.1;
print(x);
let y: f32 = 0.1;
let z: f32 = 0.2;
print(y + z);
let t: f32 = 1.0;
print(t / 3.0);
print(x == 0.1);
print(-x);
print(@into.float(x));
print(@into.f32(0.1));
print(@into.int(2.7));
let s: f32 = 0.0;
let i: int = 0;
while (i < 10) {
    s = s + 0.1;
    i = i + 1;
}
print(s);
