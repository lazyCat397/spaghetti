fn double(x: int) -> int {
    return x * 2
}

fn aplica(f: fn(int) -> int, x: int) -> int {
    return f(x)
}

fn fazSomador(n: int) -> fn(int) -> int {
    return fn(x: int) -> int {
        return x + n
    }
}

let soma3 = fazSomador(3)
print(soma3(10))
print(aplica(double, 21))
print(aplica(fn(v: int) -> int { return v * v }, 7))
let g = double
print(g(5))
print(fazSomador(100)(1))
let k = 4
let mult = fn(a: int) -> int { return a * k }
print(mult(5))
fn() { print("iife") }()
print(double)
