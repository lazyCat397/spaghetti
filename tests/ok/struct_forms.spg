import { Vec2, Box, create, sum, points, origin } from "../lib/geometry.spg"

let a: Vec2 = create(1, 1)
let b: Vec2 = Vec2 { x: 10, y: 20 }
let s: Vec2 = sum(a, b)
print(s.x)
print(s.y)

let ps: array<Vec2> = points()
print(ps[1].y)

let cx: Box = Box { corner: create(5, 5), sides: [create(1, 0), create(0, 1)] }
print(cx.corner.x + cx.sides[1].y)

origin.x = 77
print(origin.x)

fn double(v: Vec2) -> Vec2 { return Vec2 { x: v.x * 2, y: v.y * 2 } }
print(double(b).y)
