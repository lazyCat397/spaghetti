struct No {
    value: int,
    prox: No?
}

fn acha(xs: array<int>, alvo: int) -> int? {
    let i = 0
    while (i < @array.len(xs)) {
        if (xs[i] == alvo) {
            return i
        }
        i += 1
    }
    return none
}

fn double(x: int?) -> int {
    if (x == none) {
        return -1
    }
    return x * 2
}

fn sum(list: No?) -> int {
    let total = 0
    let atual = list
    while (atual != none) {
        total += atual.value
        atual = atual.prox
    }
    return total
}

fn two(a: int?, b: int?) -> int {
    if (a == none || b == none) {
        return 0
    }
    return a + b
}

fn usaLambda(x: int?) -> int {
    if (x == none) {
        return 0
    }
    let k = fn() -> int { return x + 1 }
    return k()
}

print(acha([5, 6, 7], 6), acha([5, 6, 7], 9))
print(double(4), double(none))
let a: int? = none
let b: int? = 10
print(a ?? 99, b ?? 99)
print(a == none, b != none, b == 10, a == b)
let list = No { value: 1, prox: No { value: 2, prox: No { value: 3, prox: none } } }
print(sum(list), sum(none))
let name: string? = "Ana"
if (name != none && @str.len(name) > 2) {
    print("hi ${name}")
}
print("${a} and ${b}")
let xs: array<int?> = [1, none, 3]
print(xs)
print(a ?? acha([1, 2], 2) ?? 0)
print(two(2, 3), two(none, 1), usaLambda(4), usaLambda(none))
let calls = 0
fn count() -> int {
    calls += 1
    return 7
}
print(b ?? count(), calls)
print(a ?? count(), calls)
