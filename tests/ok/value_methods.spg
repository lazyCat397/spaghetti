// methods on value types: `me` is the value the method is called on
string::methods.add(fn shout() -> string {
    return "${me}!"
})
int::methods.add(fn double() -> int {
    return me * 2
})
float::methods.add(fn half() -> float {
    return me / 2.0
})
bool::methods.add(fn flip() -> bool {
    return not me
})
print("hello".shout())
print(21.double())
print(3.0.half())
print(true.flip())
let name = "spg"
print(name.shout().shout())
// the name is free
string::methods.add(fn twice() -> string {
    return "${me}${me}"
})
print("ab".twice())
