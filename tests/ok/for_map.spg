let ages: map<string, int> = ["ana": 31, "bia": 25]
for (name, age in ages) {
    print("${name} ${age}")
}

let total = 0
for (k, v in ["x": 1, "y": 2, "z": 3]) {
    total += v
}
print(total)

for (k, v in ages) {
    if (k == "ana") {
        continue
    }
    print(k)
}

// the map is read once: the keys were taken before the loop started
let counts: map<string, int> = ["a": 1]
for (k, v in counts) {
    print(k, v)
    if (v == 1) {
        break
    }
}
