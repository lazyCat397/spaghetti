fn outer(a: int) -> fn() -> fn() -> int {
    return fn() -> fn() -> int {
        let b = a + 1
        return fn() -> int {
            return a * 100 + b
        }
    }
}
print(outer(2)()())
fn f() -> int {
    let total = 10
    let g = fn() -> int {
        return total
    }
    total = 99
    return g()
}
print(f())
