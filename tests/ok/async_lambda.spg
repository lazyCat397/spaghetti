// lambdas can be tasks too. `task<void>` falls off the end, just like a void function does
let say = fn(s: string) -> task<void> {
    print("say: ${s}")
}
let t = say("hi")
print("after")
t.wait()

let cap = 10
let addLater = fn(n: int) -> task<int> {
    @time.sleep(20)
    return n + cap
}
print(@task.all([addLater(1), addLater(2)]))
