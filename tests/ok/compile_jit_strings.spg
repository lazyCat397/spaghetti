fn shout(name: string) -> string {
    let out = ""
    compile JIT {
        out = name + "!"
    }
    return out
}
print(shout("hi"))

let words = "a"
compile JIT {
    let i = 0
    while (i < 3) {
        words = words + "x"
        i = i + 1
    }
}
print(words)

let tag = "start"
compile JIT {
    if (tag == "start") {
        tag = "end"
    }
}
print(tag)
