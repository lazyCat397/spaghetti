let a = [1, 2, 3]
let b = [1, 2, 3]
print(a == b, a != b, a == [1, 2], [[1], [2]] == [[1], [2]], ["x"] == ["x"])
let e: array<int> = []
let f: array<string> = []
print(e == [], e == [5])
@array.push(e, 5)
print(e, e == [5], f)
fn empty() -> array<int> { return [] }
fn take(x: array<float>) -> int { return @array.len(x) }
print(empty(), take([]))
let p1: map<string, int> = ["a": 1]
print(p1 == ["a": 1], p1 == [:], p1 != ["a": 2])
struct P { x: int }
print(P { x: 1 } == P { x: 1 }, P { x: 1 } != P { x: 2 })
