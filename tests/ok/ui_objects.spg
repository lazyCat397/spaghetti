attach #ui
let win = ui.window("obj", 20, 20)
win.background = ui.hex("#101010")
let red = win.rect(2.0, 3.0, 4.0, 5.0, ui.hex("#ff3300"))
red.x = red.x + 5.0
red.x += 1.5
red.color = ui.rgb(0, 255, 0)
red.visible = false
print(red.x)
print(red.visible)
print(win.width)
print(win.background)
red.visible = true
print(win.nextFrame())
red.kill()
red.kill()
print("killed")
