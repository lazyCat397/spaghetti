// for i in a..b [step s]  (end exclusive, no array is built)
for (i in 1..4) {
    print(i)
}
print("-")
for (i in 0..10 step 3) {
    print(i)
}
print("- down")
for (i in 5..0 step -2) {
    print(i)
}
for (i in 3..0 step -1) {
    print(i)
}
print("- empty")
for (i in 4..4) {
    print(i)
}
for (i in 5..1) {
    print(i)
}
for (i in 0..5 step -1) {
    print(i)
}
print("- non-literal step")
fn run(a: int, b: int, s: int) {
    for (i in a..b step s) {
        print(i)
    }
}
run(0, 7, 3)
run(7, 0, -3)
run(0, 3, -1)
run(3, 0, 1)
for (i in 0..10 step 2 + 1) {
    print(i)
}
print("- continue / break")
for (i in 0..10) {
    if (i % 2 == 0) {
        continue
    }
    if (i > 7) {
        break
    }
    print(i)
}
for (i in 9..0 step -3) {
    if (i == 6) {
        continue
    }
    print(i)
}
print("- reassigning i does not move the counter")
for (i in 0..3) {
    i = i + 10
    print(i)
}
for (i in 0..3) {
    i += 100
    print(i)
}
print("- expressions as bounds, evaluated once")
let calls = 0
fn bound() -> int {
    calls += 1
    return 3
}
for (i in 0..bound()) {
    print(i)
}
print(calls)
fn sum(n: int) -> int {
    let s = 0
    for (i in 1..n + 1) {
        s += i
    }
    return s
}
print(sum(100))
fn tri(n: int) -> int {
    let total = 0
    for (i in 0..n) {
        for (j in i..n) {
            total += j - i
        }
    }
    return total
}
print(tri(4))
print("- loop variable shadows an outer one, bounds still see the outer")
let k = 3
for (k in 0..k) {
    print(k)
}
print(k)
print("- array.range")
print(@array.range(1, 5))
print(@array.range(0, 10, 3))
print(@array.range(5, 0, -2))
print(@array.range(3, 3))
print(@array.range(3, 1))
print(@array.range(1, 3, -1))
print(@array.range(-5, 5, 5))
print(@array.range(0, 9223372036854775807, 9223372036854775807))
print(@array.range(9223372036854775800, 9223372036854775807, 3))
for (x in @array.range(0, 7, 3)) {
    print(x)
}
print(@array.len(@array.range(0, 1000)))
print("- extremes")
for (i in 9223372036854775805..9223372036854775807) {
    print(i)
}
