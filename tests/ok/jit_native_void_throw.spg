// native code: void functions, early return, print before a throw, throw across native calls
struct Counter {
    n: int,
    total: int,
}

fn bump(c: Counter, by: int) {
    c.n = c.n + by
    c.total = c.total + c.n
}

fn fill(a: array<int>, n: int) {
    let i = 0
    while (i < n) {
        a[i] = i * i
        i = i + 1
    }
}

fn early(c: Counter, stop: int) {
    if (c.n >= stop) {
        return
    }
    bump(c, 1)
}

fn check(n: int) {
    if (n > 3) {
        throw "too big: " + "x"
    }
    print(n)
}

fn outer(n: int) {
    print("outer start")
    check(n)
    print("outer end")
}

fn withTemps(c: Counter, n: int) {
    let tmp = "pre" + "fix"
    if (n > 0) {
        throw tmp + " temps"
    }
    bump(c, n)
}

let c = Counter { n: 0, total: 0 }
let i = 0
while (i < 6) {
    bump(c, i)
    early(c, 10)
    i = i + 1
}
print(c.n)
print(c.total)
let a = [0, 0, 0, 0, 0]
fill(a, 5)
print(a[4])
print(a[2])
outer(1)
outer(2)
try { outer(5) } catch (e) { print("caught: " + e) }
try { withTemps(c, 3) } catch (e) { print("caught2: " + e) }
outer(3)
print("done")
