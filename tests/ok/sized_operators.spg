let x: i8 = 5;
x++;
x--;
x += 3;
print(x);
let u: u8 = 250;
u++;
print(u);
let big: u64 = 10;
big++;
print(big);
let f: f32 = 1.5;
f++;
print(f);
struct P { n: u8 }
let p = P { n: 1 };
p.n += 1;
p.n++;
print(p.n);
let a: array<u8> = [1, 2];
a[0] += 3;
a[1]++;
print(a);
let m: map<string, i16> = ["k": 1];
m["k"] += 4;
print(m["k"]);
let neg: i8 = -5;
print(-neg);
print(-(-128 + 0 * 0 - 0 + 0 * 0) == 128);
