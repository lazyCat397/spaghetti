// if / else on a two-member union: each branch sees its member
fn half(x: int or float) -> float {
    if (type(x) == "int") {
        return x.float() / 2.0
    } else {
        return x / 2.0
    }
}
print(half(5), half(5.0))

// elif chain over three members: the last else is the one left
fn label(x: int or float or string) -> string {
    if (type(x) == "int") {
        return "int " + (x + 1).string()
    } elif (type(x) == "float") {
        return "float " + (x * 2.0).string()
    } else {
        return "string " + x
    }
}
print(label(1), label(1.5), label("s"))

// negation: != swaps the branches; a two-member union leaves its other member in the else
fn twice(x: int or float) -> float {
    if (type(x) != "int") {
        return x * 2.0
    }
    return (x * 2).float()
}
print(twice(4), twice(4.5))

// and: the right side sees the member
fn evenInt(x: int or string) -> bool {
    return type(x) == "int" and x % 2 == 0
}
print(evenInt(4), evenInt(3), evenInt("4"))

// or: the right side sees the member not tested by the left one
fn isNumber(x: int or float or string) -> bool {
    return type(x) == "int" or (type(x) == "float" and x > 0.0)
}
print(isNumber(2), isNumber(-1.5), isNumber("s"))

// while: the body sees the member
fn countdown(x: int or string) -> int {
    let n = 0
    while (type(x) == "int" and n < 3) {
        n = n + x
        x = "stop"
    }
    return n
}
print(countdown(5))
