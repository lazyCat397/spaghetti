// tests for the new builtins

let s: string = "  Hi, Spaghetti!  "
print(@str.trim(s))
print(@str.toUpper(s))
print(@str.toLower(s))
print(len("abcde"))
print(@str.charAt("world", 1))
print(@str.contains("chocolate", "cola"))
print(@str.startsWith("spaghetti", "spa"))
print(@str.endsWith("spaghetti", "etti"))
print(@str.replace("banana", "a", "o"))
print(@str.indexOf("banana", "na"))
print(@str.repeat("ab", 3))
print(@str.substring("spaghetti", 2, 6))
print(@into.string(42))
print(@into.string(3.14))
print(@into.string(true))

let parts: array<string> = @str.split("a,b,c", ",")
print(len(parts))
print(@array.join(parts, "-"))

let nums: array<int> = [5, 3, 8, 1]
print(len(nums))
@array.push(nums, 99)
print(len(nums))
print(@array.contains(nums, 8))
print(@array.indexOf(nums, 8))
let popped: int = @array.pop(nums)
print(popped)
let sortedNums: array<int> = @array.sort(nums)
print(len(sortedNums))
let reversedNums: array<int> = @array.reverse(nums)
print(len(reversedNums))
let sliced: array<int> = @array.slice(nums, 1, 3)
print(len(sliced))

print(@math.abs(-7))
print(@math.abs(-2.5))
print(@math.floor(3.9))
print(@math.ceil(3.1))
print(@math.round(3.5))
print(@math.sqrt(16.0))
print(@math.pow(2.0, 10.0))
print(@math.min(3, 9))
print(@math.max(3, 9))

print(@into.float(5))
print(@into.int(5.9))
print(@into.int("123"))
print(@into.float("3.14"))

print(len(@time.elapsed()) > 0)
print(@time.unix() > 0)
print(len(@time.now()))
