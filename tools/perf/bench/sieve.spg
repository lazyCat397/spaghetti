function run(n: int) -> int {
    let flags: array<bool> = [true]
    let i = 0
    while (i <= n) {
        @array.push(flags, true)
        i += 1
    }
    let p = 2
    while (p * p <= n) {
        if (flags[p]) {
            let m = p * p
            while (m <= n) {
                flags[m] = false
                m += p
            }
        }
        p += 1
    }
    let count = 0
    let k = 2
    while (k <= n) {
        if (flags[k]) {
            count += 1
        }
        k += 1
    }
    return count
}
print(run(6000000))
