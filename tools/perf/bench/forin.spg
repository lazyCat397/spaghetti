function run(rounds: int) -> int {
    let arr: array<int> = [0]
    let i = 0
    while (i < 1000) {
        @array.push(arr, i)
        i += 1
    }
    let total = 0
    let r = 0
    while (r < rounds) {
        for v in arr {
            total += v
        }
        r += 1
    }
    return total
}
print(run(6000))
