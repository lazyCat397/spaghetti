// `load #ui` with images: a PNG with transparent pixels, drawn at three sizes over a band,
// so the see-through parts show. the arrows move the moving one, space hides it, K kills the big one.
// needs a display, so run.sh does not run the files in examples/ui/.
load #ui

let win = ui.window("image", 480, 240)
win.background = ui.hex("#18202a")
win.rect(0.0, 70.0, 480.0, 110.0, ui.hex("#3c5a78"))

win.label(20.0, 20.0, "16px", ui.hex("#ffffff"), 16)
win.label(80.0, 20.0, "32px", ui.hex("#ffffff"), 16)
win.label(150.0, 20.0, "64px", ui.hex("#ffffff"), 16)
win.label(260.0, 20.0, "arrows, space, K", ui.hex("#9fb6cc"), 16)

let small = win.image(20.0, 100.0, "../assets/images/sprite.png", 16, 16)
let medium = win.image(80.0, 94.0, "../assets/images/sprite.png", 32, 32)
let large = win.image(150.0, 78.0, "../assets/images/sprite.png", 64, 64)
let moving = win.image(300.0, 110.0, "../assets/images/sprite.png", 48, 48)

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }

    if (win.isDown(Key.Right)) { moving.x = moving.x + 150.0 * dt }
    if (win.isDown(Key.Left)) { moving.x = moving.x - 150.0 * dt }
    if (win.wasPressed(Key.Space)) { moving.visible = !moving.visible }
    if (win.wasPressed(Key.K)) { large.kill() }
}

print("bye")
