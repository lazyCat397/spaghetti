// colors inside one text: %{#rrggbb} starts a color, %{/} goes back to the label color
install #ui

let win = ui.window("colors", 360, 160)
win.background = ui.hex("#1b1f27")

win.label(16.0, 20.0, "Life: %{#ff3300}100%{/} of 100", ui.hex("#ffffff"), 16)
win.label(16.0, 70.0, "Gold %{#ffcc00}{x}%{/} and %{#33ccff}water%{/}", ui.hex("#aaaaaa"), 16)

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }
}
