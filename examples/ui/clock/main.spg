load #ui
use ( localTime, utcOffsetMinutes ) from "helper/local-time.spg"

const PI = 3.141592653589793
const CX = 180.0
const CY = 180.0

// Two-digit padding for clock values
fn pad(n: int) -> string {
    if (n < 10) { return "0${n}" }
    return "${n}"
}

// Places a shape so its center sits `dist` px from the clock center
// along `angle` (degrees, clockwise from 12 o'clock), and rotates it.
fn place(s: Shape, dist: float, angle: float, w: float, h: float) {
    let rad = angle * PI / 180.0
    s.width = w
    s.height = h
    s.rotation = angle
    s.x = CX + dist * @math.sin(rad) - w / 2.0
    s.y = CY - dist * @math.cos(rad) - h / 2.0
}

const win = ui.window("Clock", 360, 360)
win.background = ui.hex("#000000")

// ---- Face ----
let baseClock = win.ellipse(20.0, 20.0, 320.0, 320.0, ui.hex("#25282A"))
let ring = win.ellipse(22.0, 22.0, 316.0, 316.0, ui.hex("#A6A6A0"))
ring.fill = false
ring.stroke = 3.0

// ---- Ticks: big every 5 minutes, small every minute ----
let n = 0
let deg = 0.0
while (deg < 360.0) {
    if (n % 5 == 0) {
        let big = win.rect(0.0, 0.0, 1.0, 1.0, ui.hex("#D8D4C8"))
        place(big, 148.0, deg, 4.0, 16.0)
    } else {
        let small = win.rect(0.0, 0.0, 1.0, 1.0, ui.hex("#777A79"))
        place(small, 152.0, deg, 2.0, 8.0)
    }
    deg += 6.0
    n++
}

// ---- Numerals 1..12 ----
let hour12 = 1
let numDeg = 30.0
while (hour12 <= 12) {
    let off = 9.0
    if (hour12 >= 10) { off = 18.0 }
    let rad = numDeg * PI / 180.0
    let lx = CX + 128.0 * @math.sin(rad) - off
    let ly = CY - 128.0 * @math.cos(rad) - 9.0
    win.label(lx, ly, "${hour12}", ui.hex("#D8D4C8"), 18)
    numDeg += 30.0
    hour12++
}

// ---- Clock hands ----
let hourHand = win.rect(0.0, 0.0, 6.0, 60.0, ui.hex("#E8E5DC"))
let minHand = win.rect(0.0, 0.0, 4.0, 95.0, ui.hex("#E8E5DC"))
let secHand = win.rect(0.0, 0.0, 2.0, 130.0, ui.hex("#A65E52"))
let secTail = win.rect(0.0, 0.0, 2.0, 36.0, ui.hex("#A65E52"))
let hub = win.ellipse(CX - 6.0, CY - 6.0, 12.0, 12.0, ui.hex("#A65E52"))

// ---- Digital clock ----
let digital = win.label(92.0, 222.0, "00:00:00", ui.hex("#E8E5DC"), 22)

// ---- Real time ----
let utcOffset = utcOffsetMinutes()

win.antialias = true

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }

    // Read real time every frame
    let now = localTime(utcOffset)
    let hf = @into.float(now.hour % 12)
    let mf = @into.float(now.minute)
    let sf = @into.float(now.second)

    let hourAngle = hf * 30.0 + mf * 0.5 + sf * (0.5 / 60.0)
    let minAngle = mf * 6.0 + sf * 0.1
    let secAngle = sf * 6.0

    // Redraw clock hands
    place(hourHand, 30.0, hourAngle, 6.0, 60.0)
    place(minHand, 47.5, minAngle, 4.0, 95.0)
    place(secHand, 65.0, secAngle, 2.0, 130.0)
    place(secTail, -18.0, secAngle, 2.0, 36.0)

    digital.text = "${pad(now.hour)}:${pad(now.minute)}:${pad(now.second)}"
}
