// italic: a slant in degrees, positive leans right. 0 is upright (the default)
install #ui

let win = ui.window("italic", 360, 200)
win.background = ui.hex("#1b1f27")
let font = "../assets/fonts/LiberationSans-Regular.ttf"

let upright = win.text(16.0, 12.0, "Upright text", ui.hex("#ffffff"), 32)
upright.font = font

let slanted = win.text(16.0, 60.0, "Italic, 12 degrees", ui.hex("#ffcc00"), 32)
slanted.font = font
slanted.italic = 12.0

let heavy = win.text(16.0, 110.0, "Italic with outline", ui.hex("#ffffff"), 32)
heavy.font = font
heavy.italic = 20.0
heavy.stroke = 2.0
heavy.strokeColor = ui.hex("#33ccff")

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }
}
