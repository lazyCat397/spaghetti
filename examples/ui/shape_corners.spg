// `install #ui` with each corner on its own.
// topLeftRadius, topRightRadius, bottomRightRadius and bottomLeftRadius set one corner each,
// in pixels. when the two corners of a side do not fit in it, they are scaled down together.
install #ui

let win = ui.window("corners", 360, 200)
win.background = ui.hex("#1b1f27")

// a ramp: only the top-left corner is rounded, so the card reads as a slope
let rampa = win.rect(20.0, 20.0, 150.0, 90.0, ui.hex("#2a3442"))
rampa.topLeftRadius = 90.0

// a tab: only the top corners are rounded
let aba = win.rect(200.0, 20.0, 140.0, 60.0, ui.hex("#ff66aa"))
aba.topLeftRadius = 20.0
aba.topRightRadius = 20.0

// a leaf: opposite corners rounded
let folha = win.rect(40.0, 130.0, 90.0, 50.0, ui.hex("#ffd23f"))
folha.topLeftRadius = 25.0
folha.bottomRightRadius = 25.0

// a bubble with one square corner
let balao = win.rect(200.0, 110.0, 130.0, 70.0, ui.hex("#33ccff"))
balao.radius = 20.0
balao.bottomLeftRadius = 0.0

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }

    folha.rotation = folha.rotation + 30.0 * dt
}
