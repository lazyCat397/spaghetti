// teste de indexação de arrays

let nums: array<int> = [10, 20, 30, 40]
print(nums[0])
print(nums[3])

nums[1] = 99
print(nums[1])

let i: int = 2
print(nums[i])
nums[i] = nums[i] + 1
print(nums[2])

// índice como expressão composta
print(nums[i - 1])

// array retornado de builtin, indexado direto
let sorted: array<int> = @array.sort([5, 1, 3])
print(sorted[0])
print(sorted[2])

// string vinda de split, indexada
let parts: array<string> = @str.split("a,b,c", ",")
print(parts[0])
print(parts[2])

// out of bounds deve dar erro em runtime
print(nums[99])
