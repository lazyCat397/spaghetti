let a: array<int> = [10, 20, 30]
@array.insert(a, 1, 15)
@array.insert(a, 4, 99)
print(a)
print(@array.remove(a, 0), @array.remove(a, 3))
print(a, @array.sum(a), @array.sum([1.5, 2.5]), @array.sum(@array.range(1, 5)))
print(@array.concat(a, [7, 8]), @array.concat([1], a), a)
let z = @array.fill(3, 0)
let s = @array.fill(2, "ab")
@array.push(z, 5)
print(z, s, @array.fill(0, true), @array.sum(z))
@array.clear(a)
print(a, @array.len(a), @array.sum(a))
let e: array<string> = []
@array.push(e, "x")
@array.insert(e, 0, "y")
print(e, @array.concat(e, e), @array.contains(e, "y"), @array.indexOf(e, "x"))

print(@math.sin(0.0), @math.cos(0.0), @math.tan(0.0), @math.exp(0.0), @math.log(1.0))
print(@math.round(@math.log2(8.0)), @math.round(@math.log10(1000.0)), @math.round(@math.atan2(1.0, 1.0) * 4000.0))
print(@math.round(@math.asin(1.0) * 2000.0), @math.acos(1.0), @math.atan(0.0))
print(@math.round(@math.toDegrees(@math.pi(10))), @math.round(@math.toRadians(180.0) * 1000.0))
print(@math.tau(), @math.tau(4), @math.sign(-5), @math.sign(0), @math.sign(2.5), @math.sign(-0.5))
print(@math.clamp(15, 0, 10), @math.clamp(-3, 0, 10), @math.clamp(5, 0, 10), @math.clamp(2.5, 0.0, 1.0))
print(@math.log(0.0), @math.asin(2.0))
