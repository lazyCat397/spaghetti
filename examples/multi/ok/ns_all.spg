// a bit of every namespace, deterministic output
print(len("abc") + len([1, 2]))
print(@str.toUpper("spg"))
print(@str.contains("banana", "nan"))
print(@str.indexOf("banana", "na"))
print(@array.contains([1, 2, 3], 2))
print(@array.indexOf([5, 6, 7], 7))
let xs: array<int> = [3, 1, 2]
@array.push(xs, 9)
print(len(xs))
print(@array.join(@str.split("a,b,c", ","), "+"))
print(@math.max(3, 9))
print(@math.abs(-2.5))
print(@math.floor(3.9))
print(@into.string(42) + @into.string(true))
print(@into.float(5))
print(@into.int(5.9))
print(@into.int("123") + 1)

// time: only properties, never values
// @time.elapsed() is pre-formatted text (45ms, 3s 250ms, 1h 2m...) since the program started:
// at the start it must not show hours (the old clock() bug returned ~1.7e12 ms = 472222h)
print(@str.contains(@time.elapsed(), "h"))
let u0: int = @time.unix()
@time.sleep(40)
print(@time.unix() - u0 >= 40)
let e: string = @time.elapsed()
print(@str.endsWith(e, "s"))
print(len(e) >= 3)
let agora: string = @time.now()
print(len(agora))
print(@str.charAt(agora, 10))
print(@str.endsWith(agora, "Z"))
@time.sleep(0)
