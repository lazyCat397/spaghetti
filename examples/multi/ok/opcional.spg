struct No {
    valor: int,
    prox: No?
}

function acha(xs: array<int>, alvo: int) -> int? {
    let i = 0
    while (i < @array.len(xs)) {
        if (xs[i] == alvo) {
            return i
        }
        i += 1
    }
    return none
}

function dobra(x: int?) -> int {
    if (x == none) {
        return -1
    }
    return x * 2
}

function soma(lista: No?) -> int {
    let total = 0
    let atual = lista
    while (atual != none) {
        total += atual.valor
        atual = atual.prox
    }
    return total
}

function dois(a: int?, b: int?) -> int {
    if (a == none || b == none) {
        return 0
    }
    return a + b
}

function usaLambda(x: int?) -> int {
    if (x == none) {
        return 0
    }
    let k = function() -> int { return x + 1 }
    return k()
}

print(acha([5, 6, 7], 6), acha([5, 6, 7], 9))
print(dobra(4), dobra(none))
let a: int? = none
let b: int? = 10
print(a ?? 99, b ?? 99)
print(a == none, b != none, b == 10, a == b)
let lista = No { valor: 1, prox: No { valor: 2, prox: No { valor: 3, prox: none } } }
print(soma(lista), soma(none))
let nome: string? = "Ana"
if (nome != none && @str.len(nome) > 2) {
    print("oi ${nome}")
}
print("${a} e ${b}")
let xs: array<int?> = [1, none, 3]
print(xs)
print(a ?? acha([1, 2], 2) ?? 0)
print(dois(2, 3), dois(none, 1), usaLambda(4), usaLambda(none))
let calls = 0
function conta() -> int {
    calls += 1
    return 7
}
print(b ?? conta(), calls)
print(a ?? conta(), calls)
