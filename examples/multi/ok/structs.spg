import { Vec2, Caixa, novo, soma, pontos, origem } from "../lib/geo.spg"

let a: Vec2 = novo(1, 1)
let b: Vec2 = Vec2 { x: 10, y: 20 }
let s: Vec2 = soma(a, b)
print(s.x)
print(s.y)

let ps: array<Vec2> = pontos()
print(ps[1].y)

let cx: Caixa = Caixa { canto: novo(5, 5), lados: [novo(1, 0), novo(0, 1)] }
print(cx.canto.x + cx.lados[1].y)

origem.x = 77
print(origem.x)

function dobra(v: Vec2) -> Vec2 { return Vec2 { x: v.x * 2, y: v.y * 2 } }
print(dobra(b).y)
