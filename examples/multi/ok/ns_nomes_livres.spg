// the old namespace words are plain identifiers now: every kind of
// declaration may use them, side by side with the real '@' namespaces
struct str { x: int }
function time(a: int) -> int {
    return a + 1
}
function sum(list: array<int>) -> int {
    let total: int = 0
    for n in list {
        total += n
    }
    return total
}
let math: float = 2.0
let transform: string = "t"
let s: str = str { x: 5 }
print(time(s.x))
print(sum([1, 2, 3]))
print(@math.sqrt(math * 8.0))
print(@str.toUpper(transform))
