// @str and len work in CHARACTERS, never bytes ("á" is 2 bytes, 1 character)
print(len("naïve"))
print(@str.len("naïve"))
print(@str.indexOf("façade", "ade"))
print(@str.charAt("naïve", 2))
print(@str.substring("façade", 1, 3))
print(@str.toUpper("naïve"))
print(len(@str.split("naïve", "")))
print(@array.join(@str.split("á,é,í", ","), "|"))
print(@str.repeat("é", 3))
print(len(@str.repeat("é", 3)))
print(@str.contains("brûlée", "lée"))
print(@str.startsWith("éa", "é"))
