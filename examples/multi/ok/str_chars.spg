// @str and len work in CHARACTERS, never bytes ("á" is 2 bytes, 1 character)
print(len("olá"))
print(@str.len("olá"))
print(@str.indexOf("açúcar", "car"))
print(@str.charAt("olá", 2))
print(@str.substring("ação", 1, 3))
print(@str.toUpper("olá"))
print(len(@str.split("olá", "")))
print(@array.join(@str.split("á,é,í", ","), "|"))
print(@str.repeat("é", 3))
print(len(@str.repeat("é", 3)))
print(@str.contains("coração", "ção"))
print(@str.startsWith("éa", "é"))
