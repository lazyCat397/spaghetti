// lambdas can be tasks too. `task<void>` falls off the end, just like a void function does
let say = function(s: string) -> task<void> {
    print("say: ${s}")
}
let t = say("oi")
print("depois")
t.wait()

let cap = 10
let addLater = function(n: int) -> task<int> {
    @time.sleep(20)
    return n + cap
}
print(@task.all([addLater(1), addLater(2)]))
