export function hipotenusa(a: float, b: float) -> float {
    return @math.sqrt(@math.pow(a, 2.0) + @math.pow(b, 2.0))
}

export function gritar(s: string) -> string {
    return @str.toUpper(@str.trim(s))
}

export function relogioOk() -> bool {
    let t: string = @time.elapsed()
    return len(t) > 0
}
