struct S { a: int, b: int, f: float }
function run() -> int {
    let s = S { a: 10, b: 20, f: 1.5 }
    let t = S { a: 100, b: 200, f: 9.5 }
    let k = 3
    let x = 4
    let v = 99
    let y = 0.5
    let z = 0.25
    s.a += 5
    s.b -= 2
    s.a += x
    s.b -= x
    s.a *= k
    s.f += y
    s.f -= z
    s.f *= y
    print(s.a)
    print(s.b)
    print(s.f)
    s.b = v
    s.a = 7
    s.f = y
    print(s.a)
    print(s.b)
    print(s.f)
    let u = s
    u.a += 1
    u.b *= k
    print(s.a)
    print(s.b)
    print(t.a)
    print(t.b)
    print(t.f)
    return s.a + s.b
}
print(run())
