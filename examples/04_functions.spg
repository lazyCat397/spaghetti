// a function declares its parameter types and its return type
function area(w: int, h: int) -> int {
    return w * h
}
// a function can also receive another function
function twice(f: function(int) -> int, x: int) -> int {
    return f(x)
}
print(area(3, 4))
print(twice(function(x: int) -> int { return x * 2 }, 5))
