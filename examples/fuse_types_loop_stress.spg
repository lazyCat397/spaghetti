// jump-pra-tras (while) combinado com fusao float/string/bool
function sumFloats(limit: float) -> float {
    let acc: float = 0.0
    let i: float = 0.0
    while (i < limit) {
        acc = acc + i
        i = i + 1.0
    }
    return acc
}

function countMatchingStrings(target: string) -> int {
    let words: array<string> = ["foo", "bar", "foo", "baz", "foo"]
    let count: int = 0
    for w in words {
        if (w == target) {
            count = count + 1
        }
    }
    return count
}

function xorBools(a: bool, b: bool) -> bool {
    let result: bool = false
    if (a != b) {
        result = true
    }
    return result
}

print(sumFloats(5.0))
print(countMatchingStrings("foo"))
print(xorBools(true, false))
print(xorBools(true, true))
