// `install #ui` with a struct: each sprite keeps its own shape and speed, and steps itself.
// needs a display, so run.sh skips it (the name matches *ui_demo*).
install #ui

struct Sprite {
    shape: Shape,
    dx: float,
    function step(dt: float) -> void {
        me.shape.x = me.shape.x + me.dx * dt
    }
}

let win = ui.window("sprites", 400, 200)
win.background = ui.hex("#101010")
let red = Sprite { shape: win.rect(20.0, 60.0, 40.0, 40.0, ui.hex("#ff3300")), dx: 120.0 }
let blue = Sprite { shape: win.rect(20.0, 120.0, 30.0, 30.0, ui.rgb(40, 120, 255)), dx: 60.0 }

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }
    red.step(dt)
    blue.step(dt)
}
print("bye")
