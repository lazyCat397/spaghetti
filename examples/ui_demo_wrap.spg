install #ui
let win = ui.window("wrap-e2e", 260, 200)
win.background = ui.hex("#202830")
let a = win.text(10.0, 10.0, "Um texto longo que quebra sozinho em varias linhas, centralizado no bloco", ui.hex("#ffffff"), 1)
a.wrap = 240.0
a.align = Align.Center
let b = win.text(10.0, 110.0, "Direita\nalinhada", ui.hex("#ffcc00"), 2)
b.align = Align.Right
b.wrap = 240.0
while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }
}
