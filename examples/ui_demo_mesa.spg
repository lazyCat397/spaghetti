// Mesa: um app de desenho com ui.
// - clique numa cor da paleta para escolher o pincel
// - segure o botão esquerdo na área de desenho para pintar
// - o botão Limpar apaga tudo (ou aperte C)
// - o contador mostra quantos traços existem
install #ui

let win = ui.window("Mesa", 400, 300)
win.background = ui.hex("#1e1e28")

let cores = [ui.hex("#ff4d4d"), ui.hex("#4dff88"), ui.hex("#4da6ff"), ui.hex("#ffffff")]

// paleta: quatro quadrados no topo
let paleta: array<Shape> = []
let i = 0
let x = 10.0
while (i < 4) {
    paleta.push(win.rect(x, 10.0, 28.0, 28.0, cores[i]))
    x = x + 34.0
    i = i + 1
}

// botão Limpar, com o texto por cima (texto não recebe clique: o clique vai ao retângulo)
let limpar = win.rect(300.0, 10.0, 90.0, 28.0, ui.hex("#55556a"))
let textoLimpar = win.text(316.0, 18.0, "Limpar", ui.hex("#ffffff"), 1)

let contador = win.text(10.0, 270.0, "Traços: 0", ui.hex("#aaaacc"), 2)

let pincel = 0
let traços: array<Shape> = []

// a área de desenho começa abaixo da paleta
let topo = 50.0

while (true) {
    let dt = win.nextFrame()
    if (dt < 0.0) { break }

    // escolher a cor
    i = 0
    while (i < 4) {
        if (paleta[i].mousePressed(Mouse.Left)) { pincel = i }
        i = i + 1
    }

    // limpar, pelo botão ou pela tecla C
    if (limpar.mousePressed(Mouse.Left) || win.wasPressed(Key.C)) {
        while (traços.len() > 0) {
            let velho = traços.pop()
            velho.kill()
        }
    }

    // pintar: enquanto o botão esquerdo está preso sobre a área de desenho
    if (win.mouseDown(Mouse.Left) && win.mouseInside && win.mouseY > topo) {
        traços.push(win.rect(win.mouseX - 2.0, win.mouseY - 2.0, 4.0, 4.0, cores[pincel]))
    }

    contador.text = "Traços: " + traços.len().string()
}
print("até a próxima")
