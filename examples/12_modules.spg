// attach brings EVERY public name of the file, without listing them
attach "lib/greet.spg"

print(greet("Spaghetti"))
print(shout("Spaghetti"))

// use is the selective form: it brings only the names you list
// wave() is public in farewell.spg, but it is not used here
use (farewell) from "lib/farewell.spg"

print(farewell("Spaghetti"))
