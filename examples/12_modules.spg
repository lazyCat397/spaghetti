// install brings EVERY exported name of the file, without listing them
install "lib/greet.spg"

print(greet("Spaghetti"))
print(shout("Spaghetti"))

// import is the selective form: it brings only the names you list
// wave() is exported by farewell.spg, but it is not imported here
import (farewell) from "lib/farewell.spg"

print(farewell("Spaghetti"))
