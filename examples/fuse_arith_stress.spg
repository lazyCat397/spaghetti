// stress test completo do pacote matematico fundido (Sub/Mul/Div/Mod, int e float)

function testInt(a: int, b: int) -> void {
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
}

function testFloat(a: float, b: float) -> void {
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
}

function testIntDivZero(a: int, zero: int) -> int {
    return a / zero
}

function testIntModZero(a: int, zero: int) -> int {
    return a % zero
}

testInt(17, 5)
testInt(-9, 4)
testFloat(17.5, 2.5)
testFloat(-9.5, 4.0)

print("float div by zero:")
let a: float = 5.0
let z: float = 0.0
print(a / z)
print(a % z)

print("int div by zero (deve dar erro):")
print(testIntDivZero(10, 0))
