{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spaghetti",
  "scopeName": "source.spg",
  "patterns": [
    {
      "include": "#directives"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#raw-strings"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#function-value"
    },
    {
      "include": "#guard-header"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#member"
    },
    {
      "include": "#type-names"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "directives": {
      "match": "^\\s*(#>)\\s*([A-Za-z][A-Za-z0-9_-]*)(?:[ \\t]+(\\d+))?",
      "name": "meta.directive.spg",
      "captures": {
        "1": {
          "name": "keyword.other.directive.spg"
        },
        "2": {
          "name": "keyword.other.directive.spg"
        },
        "3": {
          "name": "constant.numeric.integer.spg"
        }
      }
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\{",
          "end": "\\}/",
          "name": "comment.block.spg"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.spg"
        }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.spg",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.spg"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.spg"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.spg"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "raw-strings": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.spg",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.spg"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.spg"
        }
      }
    },
    "interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "name": "meta.interpolation.spg",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.spg"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.spg"
        }
      },
      "contentName": "meta.embedded.line.spg",
      "patterns": [
        {
          "include": "#interp-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "interp-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interp-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "function-value": {
      "match": "(?<![\\p{L}\\p{N}_])(?:fn)(?![\\p{L}\\p{N}_])(?=\\s*\\()",
      "name": "storage.type.function.spg"
    },
    "definitions": {
      "patterns": [
        {
          "match": "((?<![\\p{L}\\p{N}_])fn(?![\\p{L}\\p{N}_]))\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.spg"
            },
            "2": {
              "name": "entity.name.function.spg"
            }
          }
        },
        {
          "match": "((?<![\\p{L}\\p{N}_])struct(?![\\p{L}\\p{N}_]))\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.spg"
            },
            "2": {
              "name": "entity.name.type.struct.spg"
            }
          }
        },
        {
          "match": "((?<![\\p{L}\\p{N}_])namespace(?![\\p{L}\\p{N}_]))\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.namespace.spg"
            },
            "2": {
              "name": "entity.name.type.namespace.spg"
            }
          }
        },
        {
          "match": "((?<![\\p{L}\\p{N}_])enum(?![\\p{L}\\p{N}_]))\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.spg"
            },
            "2": {
              "name": "entity.name.type.enum.spg"
            }
          }
        },
        {
          "match": "((?<![\\p{L}\\p{N}_])(?:let|const)(?![\\p{L}\\p{N}_]))\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.spg"
            },
            "2": {
              "name": "variable.other.definition.spg"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:then|and|or|not)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.logical.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:if|elif|else|when)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.conditional.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:while|do|for|in|break|continue)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.loop.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:try|catch|throw)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.trycatch.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:return)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.flow.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:guard)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.guard.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:use|public|from|load)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.use.spg"
        },
        {
          "match": "((?<![\\p{L}\\p{N}_])compile(?![\\p{L}\\p{N}_]))(\\s+)((?<![\\p{L}\\p{N}_])(?:VM|JIT)(?![\\p{L}\\p{N}_]))",
          "captures": {
            "1": {
              "name": "keyword.control.compile.spg"
            },
            "3": {
              "name": "keyword.control.compile.target.spg"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:step)(?![\\p{L}\\p{N}_])(?=\\s+[-(\\p{L}_\\p{N}])",
          "name": "keyword.control.loop.step.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:let|const)(?![\\p{L}\\p{N}_])",
          "name": "storage.type.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:me)(?![\\p{L}\\p{N}_])",
          "name": "variable.language.me.spg"
        }
      ]
    },
    "types": {
      "match": "(?<![\\p{L}\\p{N}_])(?:int|float|bool|string|void|array)(?![\\p{L}\\p{N}_])|(?<![\\p{L}\\p{N}_])map(?![\\p{L}\\p{N}_])(?=\\s*<)|(?<![\\p{L}\\p{N}_])task(?![\\p{L}\\p{N}_])(?=\\s*<)",
      "name": "support.type.primitive.spg"
    },
    "constants": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:true|false)(?![\\p{L}\\p{N}_])",
          "name": "constant.language.boolean.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:none)(?![\\p{L}\\p{N}_])",
          "name": "constant.language.none.spg"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])0[xX][0-9A-Fa-f_]+(?![\\p{L}\\p{N}_])|(?<![\\p{L}\\p{N}_])0[bB][01_]+(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.integer.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])\\d[\\d_]*(?:\\.\\d[\\d_]*)?[eE][+-]?\\d+(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.float.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])\\d[\\d_]*\\.\\d[\\d_]*(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.float.spg"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])\\d[\\d_]*(?![\\p{L}\\p{N}_])",
          "name": "constant.numeric.integer.spg"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "match": "\\b(load)\\s*(#[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.spg"
            },
            "2": {
              "name": "entity.name.namespace.spg"
            }
          }
        },
        {
          "match": "(?<![.A-Za-z0-9_@])(@(?:str|array|map|into|math|time|file|sys|json|task|char))(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.spg"
            },
            "2": {
              "name": "punctuation.accessor.spg"
            },
            "3": {
              "name": "support.function.builtin.spg"
            }
          }
        },
        {
          "match": "(?<![.A-Za-z0-9_@])@(?:str|array|map|into|math|time|file|sys|json|task|char)\\b(?=\\s*\\.)",
          "name": "entity.name.namespace.spg"
        },
        {
          "match": "(?<![.A-Za-z0-9_@])((?:ps|http|terminal|regex|crypto|csv|test|toml|sqlite|net|cmd|json5|ui))(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.spg"
            },
            "2": {
              "name": "punctuation.accessor.spg"
            },
            "3": {
              "name": "support.function.builtin.spg"
            }
          }
        },
        {
          "match": "(?<![.A-Za-z0-9_])(Key|Mouse|Align)(\\.)([A-Za-z][A-Za-z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.type.enum.spg"
            },
            "2": {
              "name": "punctuation.accessor.spg"
            },
            "3": {
              "name": "constant.other.enum.spg"
            }
          }
        },
        {
          "comment": "the native objects of load #ui: Window, Shape, Label and Image",
          "match": "(?<![.A-Za-z0-9_])(Window|Shape|Label|Image)\\b(?!\\s*\\()",
          "name": "entity.name.type.spg"
        }
      ]
    },
    "builtins": {
      "match": "(?<![\\p{L}\\p{N}_])(?:print|printError|readLine|len|type)(?![\\p{L}\\p{N}_])(?=\\s*\\()",
      "name": "support.function.builtin.spg"
    },
    "calls": {
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()",
      "name": "entity.name.function.call.spg"
    },
    "member": {
      "match": "(?<=[^.]\\.)\\s*[\\p{L}_][\\p{L}\\p{N}_]*",
      "name": "variable.other.property.spg"
    },
    "type-names": {
      "match": "(?<![\\p{L}\\p{N}_])\\p{Lu}[\\p{L}\\p{N}_]*(?![\\p{L}\\p{N}_])",
      "name": "entity.name.type.spg"
    },
    "operators": {
      "patterns": [
        {
          "match": "::",
          "name": "keyword.operator.type-property.spg"
        },
        {
          "match": "(?<=::)\\s*[\\p{L}_][\\p{L}\\p{N}_]*",
          "name": "constant.other.type-property.spg"
        },
        {
          "match": "\\|>",
          "name": "keyword.operator.pipe.spg"
        },
        {
          "match": "\\?\\?",
          "name": "keyword.operator.coalesce.spg"
        },
        {
          "match": "\\?",
          "name": "keyword.operator.optional.spg"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.range.spg"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.spg"
        },
        {
          "match": "==|!=|<=|>=|&&|\\|\\|",
          "name": "keyword.operator.logical.spg"
        },
        {
          "match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=",
          "name": "keyword.operator.assignment.compound.spg"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.spg"
        },
        {
          "match": "[-+*/%<>!]",
          "name": "keyword.operator.arithmetic.spg"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.spg"
        }
      ]
    },
    "guard-header": {
      "begin": "((?<![\\p{L}\\p{N}_])guard(?![\\p{L}\\p{N}_]))(\\s*)(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.guard.spg"
        },
        "3": {
          "name": "punctuation.section.parens.begin.spg"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.spg"
        }
      },
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:me)(?![\\p{L}\\p{N}_])",
          "name": "variable.language.me.spg"
        },
        {
          "match": "((?<![\\p{L}\\p{N}_])as(?![\\p{L}\\p{N}_]))(\\s+)([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.guard.spg"
            },
            "3": {
              "name": "variable.other.definition.spg"
            }
          }
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.spg"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
          "name": "variable.other.property.spg"
        }
      ]
    }
  }
}
