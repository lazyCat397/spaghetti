{
  "Function": {
    "prefix": [
      "fn",
      "function"
    ],
    "body": [
      "function ${1:name}(${2:a}: ${3:int}) -> ${4:int} {",
      "\t$0",
      "}"
    ],
    "description": "Declare a function"
  },
  "Exported function": {
    "prefix": "exportfn",
    "body": [
      "export function ${1:name}(${2:a}: ${3:int}) -> ${4:int} {",
      "\t$0",
      "}"
    ],
    "description": "Function exportable to other files"
  },
  "Install": {
    "prefix": "install",
    "body": [
      "install \"${1:./file.spg}\""
    ],
    "description": "Bring in every exported name of a file (import { x } wins on a clash)"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:First},",
      "\t${3:Second}",
      "}"
    ],
    "description": "Declare an enum (loop over it with: for x in Name)"
  },
  "let": {
    "prefix": "let",
    "body": "let ${1:name}: ${2:int} = ${3:0}",
    "description": "Mutable variable"
  },
  "const": {
    "prefix": "const",
    "body": "const ${1:name}: ${2:int} = ${3:0}",
    "description": "Constant"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if / else": {
    "prefix": "ife",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if with else"
  },
  "if / elif / else": {
    "prefix": "ifelif",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} elif (${3:other}) {",
      "\t$4",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / elif / else chain"
  },
  "when (match)": {
    "prefix": "when",
    "body": [
      "when (${1:value}) {",
      "\t${2:\"case\"} {",
      "\t\t$0",
      "\t}",
      "\telse {",
      "\t\t",
      "\t}",
      "}"
    ],
    "description": "match on an int, a string or an enum (cases list: \"a\", \"b\" { })"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  },
  "for in": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "for-in loop"
  },
  "for range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t$0",
      "}"
    ],
    "description": "Counting loop, end exclusive (add `step 2` for a custom step)"
  },
  "struct with method": {
    "prefix": "structm",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int}",
      "",
      "\tfunction ${4:method}() -> ${5:int} {",
      "\t\treturn me.${2:field}",
      "\t}",
      "}"
    ],
    "description": "Struct with a method (`me` is the value the method is called on)"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int},",
      "\t${4:other}: ${5:string}",
      "}"
    ],
    "description": "Declare a struct (fields separated by commas)"
  },
  "try / catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:e}) {",
      "\t$0",
      "}"
    ],
    "description": "try/catch block"
  },
  "import": {
    "prefix": "import",
    "body": "import { ${1:name} } from \"${2:./file}.spg\"",
    "description": "Named import (the .spg extension is mandatory)"
  },
  "re-export": {
    "prefix": "reexport",
    "body": "export { ${1:name} } from \"${2:./file}.spg\"",
    "description": "Re-export from another file"
  },
  "print": {
    "prefix": "print",
    "body": "print(${1:value})",
    "description": "Print to the terminal"
  },
  "Map": {
    "prefix": "map",
    "body": [
      "let ${1:name}: map<${2:string}, ${3:int}> = [${4::}]"
    ],
    "description": "typed map (empty: [:])"
  },
  "throw": {
    "prefix": "throw",
    "body": [
      "throw \"${1:message}\""
    ],
    "description": "raise an exception with a message (caught by try/catch, in this function or any caller)"
  },
  "Lambda": {
    "prefix": [
      "lambda",
      "fnv"
    ],
    "body": [
      "function(${1:x}: ${2:int}) -> ${3:int} {",
      "\t$0",
      "}"
    ],
    "description": "Anonymous function value (a lambda)"
  },
  "Function type": {
    "prefix": [
      "fntype"
    ],
    "body": [
      "function(${1:int}) -> ${2:int}"
    ],
    "description": "Type of a function value"
  },
  "Optional type": {
    "prefix": [
      "opt",
      "opt?"
    ],
    "body": [
      "${1:int}?"
    ],
    "description": "Optional type: a value of ${1:int} or none"
  },
  "Optional let": {
    "prefix": [
      "letopt"
    ],
    "body": [
      "let ${1:x}: ${2:int}? = ${3:none}"
    ],
    "description": "Mutable optional variable"
  },
  "Check none": {
    "prefix": [
      "ifnone",
      "ifn"
    ],
    "body": [
      "if (${1:x} != none) {",
      "\t$0",
      "}"
    ],
    "description": "Runs the block only when the optional is not none (narrows its type inside)"
  },
  "Default value": {
    "prefix": [
      "coalesce",
      "??"
    ],
    "body": [
      "${1:x} ?? ${2:0}"
    ],
    "description": "The value of an optional, or a default when it is none"
  },
  "Interpolation": {
    "prefix": [
      "interp",
      "${"
    ],
    "body": [
      "\"${${1:expr}}\""
    ],
    "description": "String with an embedded expression"
  },
  "UI window loop": {
    "prefix": [
      "uiloop",
      "ui loop"
    ],
    "body": [
      "install #ui",
      "",
      "let win = ui.window(\"${1:demo}\", ${2:800}, ${3:600})",
      "win.background = ui.hex(\"#${4:101010}\")",
      "",
      "while (true) {",
      "\tlet dt = win.nextFrame()",
      "\tif (dt < 0.0) { break }",
      "\t$0",
      "}"
    ],
    "description": "A window and its frame loop (the loop ends when the window closes)"
  },
  "UI rectangle": {
    "prefix": [
      "uirect",
      "ui rect"
    ],
    "body": [
      "let ${1:box} = win.rect(${2:100.0}, ${3:100.0}, ${4:40.0}, ${5:40.0}, ui.hex(\"#${6:ff3300}\"))"
    ],
    "description": "A rectangle the window keeps: change its fields to move or recolor it"
  },
  "UI keys": {
    "prefix": [
      "uikey",
      "ui key"
    ],
    "body": [
      "if (win.isDown(Key.${1:Right})) { ${2:box}.x = ${2:box}.x + ${3:200.0} * dt }"
    ],
    "description": "Move while a key is held (Key is an enum: Key.Space, Key.A, Key.Left...)"
  },
  "UI pressed": {
    "prefix": [
      "uipressed",
      "ui pressed"
    ],
    "body": [
      "if (win.wasPressed(Key.${1:Space})) {",
      "\t$0",
      "}"
    ],
    "description": "Run once, on the frame the key goes down"
  },
  "UI onClose": {
    "prefix": [
      "uiclose",
      "ui onclose"
    ],
    "body": [
      "win.onClose(function() -> void {",
      "\t$0",
      "})"
    ],
    "description": "Run when the window closes (the X, Esc or win.close())"
  },
  "UI onFocus": {
    "prefix": [
      "uifocus",
      "ui onfocus"
    ],
    "body": [
      "win.onFocus(function() -> void {",
      "\t$0",
      "})"
    ],
    "description": "Run when the window gains the focus of the system"
  },
  "UI onBlur": {
    "prefix": [
      "uiblur",
      "ui onblur"
    ],
    "body": [
      "win.onBlur(function() -> void {",
      "\t$0",
      "})"
    ],
    "description": "Run when the window loses the focus of the system"
  },
  "UI onResize": {
    "prefix": [
      "uiresize",
      "ui onresize"
    ],
    "body": [
      "win.onResize(function(${1:w}: int, ${2:h}: int) -> void {",
      "\t$0",
      "})"
    ],
    "description": "Run with the new width and height when the user resizes the window"
  },
  "UI mouse": {
    "prefix": [
      "uimouse",
      "ui mouse"
    ],
    "body": [
      "if (win.mousePressed(Mouse.${1:Left})) {",
      "\t$0",
      "}"
    ],
    "description": "Run once, on the frame the mouse button goes down (Mouse: Left, Right, Middle)"
  },
  "UI text": {
    "prefix": [
      "uitext",
      "ui text"
    ],
    "body": [
      "let ${1:label} = win.text(${2:10.0}, ${3:10.0}, \"${4:Olá}\", ui.hex(\"#${5:ffffff}\"), ${6:2})"
    ],
    "description": "A line of text the window keeps (scale 1 to 8; \\n starts a new line; accents are in the font)"
  }
}
